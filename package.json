{
  "name": "wanxiangshu",
  "version": "0.9.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/OpenCode/Plugin/Plugin.js",
  "exports": {
    ".": "./dist/OpenCode/Plugin/Plugin.js"
  },
  "files": [
    "dist/",
    "resources/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "@waishnav/devspace": true,
    "better-sqlite3": true,
    "node-pty": true
  },
  "packageManager": "npm@11.12.1",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "format-build-test": "node scripts/verify.mjs",
    "verify:release": "node scripts/verify.mjs --release",
    "coverage": "node scripts/coverage.mjs",
    "format": "dotnet tool run fantomas src/Wanxiangshu",
    "format:check": "wireit",
    "check": "wireit",
    "build": "node scripts/build.mjs",
    "deps:update": "node scripts/wanxiangli-source.mjs update",
    "deps:build": "node scripts/wanxiangli-source.mjs build",
    "check:no-archives": "node scripts/wanxiangli-source.mjs check",
    "ci:local": "bash scripts/ci-local.sh",
    "diagnostics:collect": "node scripts/diagnostics/collect-incident.mjs"
  },
  "wireit": {
    "format:check": {
      "command": "dotnet tool run fantomas --check src/Wanxiangshu",
      "files": [
        "src/Wanxiangshu/**/*.fs",
        "src/Wanxiangshu/**/*.fsi",
        "src/Wanxiangshu/**/*.fsproj",
        ".editorconfig",
        "**/.editorconfig",
        ".fantomasignore",
        ".config/dotnet-tools.json",
        "global.json",
        "package.json",
        "package-lock.json"
      ],
      "output": []
    },
    "check": {
      "command": "node scripts/wanxiangli-source.mjs check && node scripts/check.mjs",
      "files": [
        "scripts/check.mjs",
        "scripts/wanxiangli-source.mjs",
        ".gitmodules",
        "wanxiangli/package.json",
        "wanxiangli/package-lock.json",
        "scripts/checks/*",
        "scripts/lib/*",
        "src/Wanxiangshu/**",
        "resources/**",
        "package.json",
        "package-lock.json"
      ],
      "output": []
    }
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.4"
  },
  "dependencies": {
    "@fable-org/fable-library-js": "2.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bun-pty": "^0.4.10",
    "gpt-tokenizer": "^4.0.0",
    "wanxiangli": "file:wanxiangli",
    "zod": "4.5.4"
  },
  "overrides": {
    "bun-pty": "$bun-pty"
  },
  "bundleDependencies": [
    "wanxiangli"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "acorn": "^8.18.0",
    "c8": "^10.1.3",
    "fast-check": "4.9.0",
    "opencode-ai": "1.18.29",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "1.8.0",
    "tar": "^7.5.22",
    "wireit": "^0.14.13"
  }
}
