<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>durable-composition</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>host-fact</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-composition</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>host-fact</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-composition.host-fact-cases.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <Compile Include="Host/Fact.fsi"/>
    <Compile Include="Host/Fact.fs"/>
  </ItemGroup>
</Project>
