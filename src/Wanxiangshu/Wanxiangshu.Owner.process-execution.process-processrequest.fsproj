<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>process</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>process-processrequest</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>process-execution</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>process-processrequest</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.process-node-timing-adapter.fsproj"/>
    <Compile Include="Process/ProcessRequest.fsi"/>
    <Compile Include="Process/ProcessRequest.fs"/>
    <Compile Include="Process/Spool.fsi"/>
    <Compile Include="Process/Spool.fs"/>
    <Compile Include="Process/PtyTypes.fsi"/>
    <Compile Include="Process/PtyTypes.fs"/>
    <Compile Include="Process/PtySession.fsi"/>
    <Compile Include="Process/PtySession.fs"/>
    <Compile Include="Process/Pty.fsi"/>
    <Compile Include="Process/Pty.fs"/>
    <Compile Include="Process/PtySupervisor.fsi"/>
    <Compile Include="Process/PtySupervisor.fs"/>
    <Compile Include="Process/PtyBackend.fsi"/>
    <Compile Include="Process/PtyBackend.fs"/>
    <Compile Include="Process/PtyApi.fsi"/>
    <Compile Include="Process/PtyApi.fs"/>
  </ItemGroup>
</Project>
