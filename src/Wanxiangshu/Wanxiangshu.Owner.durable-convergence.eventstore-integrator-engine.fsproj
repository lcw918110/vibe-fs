<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>eventstore-integrator-engine</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-convergence</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>eventstore-integrator-engine</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>runtime</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.eventstore-integrator-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.eventstore-process-log.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-canonicalcodec.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-model.fsproj"/>
    <Compile Include="Persistence/EventStore/IntegratorEngine.fsi"/>
    <Compile Include="Persistence/EventStore/IntegratorEngine.fs"/>
  </ItemGroup>
</Project>
