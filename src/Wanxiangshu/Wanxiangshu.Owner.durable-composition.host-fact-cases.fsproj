<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>durable-composition</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>host-fact-cases</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-composition</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>host-fact-cases</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <Compile Include="Host/Facts.fsi"/>
    <Compile Include="Host/Facts.fs"/>
  </ItemGroup>
</Project>
