<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>runtime-platform</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>persistence-runtime-path</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-events</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>persistence-runtime-path</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>adapter</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Persistence/Journal/RuntimePath.fsi"/>
    <Compile Include="Persistence/Journal/RuntimePath.fs"/>
  </ItemGroup>
</Project>
