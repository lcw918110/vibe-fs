<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>dispatch</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>interaction-attempt-contract</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>dispatch-protocol</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>interaction-attempt-contract</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
