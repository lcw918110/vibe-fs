<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>eventstore-process-log</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-convergence</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>eventstore-process-log</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>runtime</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-canonicalcodec.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-storetypes.fsproj"/>
    <Compile Include="Persistence/EventStore/ProcessEventLog.fsi"/>
    <Compile Include="Persistence/EventStore/ProcessEventLog.fs"/>
  </ItemGroup>
</Project>
