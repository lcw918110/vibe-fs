<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>context</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>context-companion-fact</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>context-compression</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>context-companion-fact</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.context-compression.context-companion-facts.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-llm-facing.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-attempt-recovery.participant-provider-attempt-requestkind.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-projection.participant-provider-projection-wire.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.runtime-platform.digest.fsproj"/>
    <Compile Include="Participant/Provider/Attempt/TerminalValidity.fsi"/>
    <Compile Include="Participant/Provider/Attempt/TerminalValidity.fs"/>

    <Compile Include="Host/CompactionPolicy.fsi"/>
    <Compile Include="Host/CompactionPolicy.fs"/>
    <Compile Include="Context/Companion/Projection.fsi"/>
    <Compile Include="Context/Companion/Projection.fs"/>
  </ItemGroup>
</Project>
