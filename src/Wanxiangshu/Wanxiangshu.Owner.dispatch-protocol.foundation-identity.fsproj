<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSemanticOwner>dispatch-protocol</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>foundation-identity</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
    <WanxiangshuSubsystem>runtime-platform</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>identity</WanxiangshuCompileShard>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Foundation/Identity.fsi"/>
    <Compile Include="Foundation/Identity.fs"/>
    <Compile Include="Foundation/Quiescence.fsi"/>
    <Compile Include="Foundation/Quiescence.fs"/>
  </ItemGroup>
</Project>
