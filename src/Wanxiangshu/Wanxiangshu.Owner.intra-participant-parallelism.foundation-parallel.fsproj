<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSemanticOwner>intra-participant-parallelism</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>foundation-parallel</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
    <WanxiangshuSubsystem>runtime-platform</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>bounded-parallel</WanxiangshuCompileShard>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Foundation/Defer.fsi"/>
    <Compile Include="Foundation/Defer.fs"/>
  </ItemGroup>
</Project>
